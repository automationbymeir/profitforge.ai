# Azure Functions Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# =============================================================================
# AZURE STORAGE
# =============================================================================
# Required for Azure Functions runtime and blob storage
# Get from: Azure Portal → Storage Account → Access Keys
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net

# Container name for uploaded documents (default: uploads)
STORAGE_CONTAINER_DOCUMENTS=uploads

# =============================================================================
# DATABASE
# =============================================================================
# Azure SQL Database connection string
# Format: Server=tcp:{server}.database.windows.net,1433;Database={db};User ID={user};Password={password};Encrypt=true;Connection Timeout=30;
SQL_CONNECTION_STRING=Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=YOUR_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=true;Connection Timeout=30;

# =============================================================================
# AZURE DOCUMENT INTELLIGENCE (OCR)
# =============================================================================
# Azure AI Document Intelligence for OCR extraction
# Get from: Azure Portal → Document Intelligence → Keys and Endpoint
DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR_REGION.api.cognitive.microsoft.com/
DOCUMENT_INTELLIGENCE_KEY=YOUR_DOCUMENT_INTELLIGENCE_KEY

# =============================================================================
# AZURE OPENAI / AI FOUNDRY (GPT-4o)
# =============================================================================
# Azure OpenAI endpoint for product extraction
# Get from: Azure Portal → Azure OpenAI → Keys and Endpoint
AI_PROJECT_ENDPOINT=https://YOUR_OPENAI_ACCOUNT.openai.azure.com
AI_PROJECT_KEY=YOUR_OPENAI_KEY

# =============================================================================
# FUNCTION APP CONFIGURATION
# =============================================================================
# URL where your function app is accessible
# Local dev: http://localhost:7071
# Staging: https://staging-vvocr-functions.azurewebsites.net
FUNCTION_APP_URL=http://localhost:7071

# =============================================================================
# DEMO MODE & RATE LIMITING (Optional)
# =============================================================================
# Enable demo mode for public deployments with rate limits
IS_DEMO_MODE=false

# Max uploads per day (0 = unlimited, only enforced if IS_DEMO_MODE=true)
MAX_DAILY_UPLOADS=0

# Max file size in MB (0 = unlimited, only enforced if IS_DEMO_MODE=true)
MAX_FILE_SIZE_MB=0

# Max uploads per IP per hour (0 = unlimited, only enforced if IS_DEMO_MODE=true)
MAX_UPLOADS_PER_IP_PER_HOUR=0

# Demo API key (required if IS_DEMO_MODE=true)
DEMO_API_KEY=

# Usage data retention in days
USAGE_RETENTION_DAYS=30

# =============================================================================
# NOTES
# =============================================================================
# 1. Get Azure resource credentials from your Pulumi deployment outputs:
#    pulumi stack output --show-secrets
#
# 2. For local development, you can use Azure Storage Emulator (Azurite):
#    Install: npm install -g azurite
#    Run: azurite --silent --location /tmp/azurite --debug /tmp/azurite-debug.log
#
# 3. Test your configuration:
#    npm run dev
#    curl http://localhost:7071/api/health
