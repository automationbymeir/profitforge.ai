# Integration Test Environment Configuration
# These are well-known public credentials for local emulators only
# Safe to commit - they only work with Docker containers on localhost

# =============================================================================
# DOCKER SQL SERVER (Local)
# =============================================================================
# Matches docker-compose.test.yml configuration
SQL_CONNECTION_STRING=Server=localhost,1433;Database=master;User Id=sa;Password=TestPassword123!;Encrypt=false;TrustServerCertificate=true

# =============================================================================
# AZURITE STORAGE EMULATOR (Local)
# =============================================================================
# Microsoft's standard development storage account credentials
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;

# =============================================================================
# MOCK AI SERVICES (Not real, used for testing)
# =============================================================================
# These don't need to be real - integration tests mock the Azure SDK
DOCUMENT_INTELLIGENCE_ENDPOINT=https://mock-doc-intel.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=MOCK_KEY_NOT_REAL
AI_PROJECT_ENDPOINT=https://mock-ai.cognitiveservices.azure.com
AI_PROJECT_KEY=MOCK_KEY_NOT_REAL
AI_MODEL_NAME=gpt-4o

# =============================================================================
# FUNCTIONS APP
# =============================================================================
FUNCTION_APP_URL=http://localhost:7071
FUNCTIONS_WORKER_RUNTIME=node
NODE_ENV=test

# Azure Functions secret storage (use local files, not KeyVault)
AzureWebJobsSecretStorageType=files
# Tell Functions to use Azurite emulator
AzureWebJobsStorage=UseDevelopmentStorage=true
# Enable worker indexing for faster cold starts
AzureWebJobsFeatureFlags=EnableWorkerIndexing

# =============================================================================
# STORAGE CONTAINER NAMES
# =============================================================================
STORAGE_CONTAINER_DOCUMENTS=uploads

# =============================================================================
# TEST SETTINGS
# =============================================================================
IS_DEMO_MODE=false
MAX_FILE_SIZE_MB=10
