# E2E Test Environment Variables
# Copy this file to .env.e2e and add YOUR REAL Azure credentials
# 
# ⚠️  IMPORTANT: .env.e2e is gitignored - NEVER commit real credentials!
# 
# E2E tests use production Azure resources for end-to-end validation
# Get these values from Azure Portal or Pulumi outputs

# Azure Functions Runtime
FUNCTIONS_WORKER_RUNTIME=node

# Azure SQL Database
# Get from: Azure Portal > SQL Database > Connection strings
SQL_CONNECTION_STRING=Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=YOUR_DATABASE;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;

# Azure Blob Storage
# Get from: Azure Portal > Storage Account > Access keys
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_KEY_HERE;EndpointSuffix=core.windows.net
STORAGE_CONTAINER_DOCUMENTS=uploads

# Azure OpenAI (for AI Product Mapper)
# Get from: Azure Portal > Azure OpenAI > Keys and Endpoint
AI_PROJECT_ENDPOINT=https://YOUR_OPENAI_ACCOUNT.openai.azure.com
AI_PROJECT_KEY=YOUR_OPENAI_KEY_HERE

# Azure Document Intelligence (for OCR)
# Get from: Azure Portal > Document Intelligence > Keys and Endpoint
DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR_REGION.api.cognitive.microsoft.com/
DOCUMENT_INTELLIGENCE_KEY=YOUR_DOC_INTEL_KEY_HERE

# Test Settings
# Use http://localhost:7071 for local Functions or deployed URL for remote testing
FUNCTION_APP_URL=http://localhost:7071
IS_DEMO_MODE=false
MAX_FILE_SIZE_MB=10
